class Solution {
    public List<List<Integer>> func(int[] arr,int ind, List ls,List ans){
        if(ind >= arr.length){
            ans.add(new ArrayList<>(ls));
            return ans;
        }
        ls.add(arr[ind]);
        func(arr,ind+1,ls,ans);
        ls.remove(ls.size() -1);
        func(arr,ind+1,ls,ans);
        return ans;
    }
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        List<Integer> ls = new ArrayList<>();
        return func(nums,0,ls,ans);
    }
}
