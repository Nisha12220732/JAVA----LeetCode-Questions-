class Solution {
    public List<List<Integer>> func(int[] arr, int target,int ind,List ls,List ans){
        if(ind >= arr.length){
            if(target == 0){
                ans.add(new ArrayList<>(ls));
            }
            return ans;
        }
        if(arr[ind] <= target){
            ls.add(arr[ind]);
            func(arr,target - arr[ind],ind,ls,ans);
            ls.remove(ls.size() -1);
        }
        func(arr,target,ind+1,ls,ans);
        return ans;
    }


    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        List<List<Integer>> ans = new ArrayList<>();
        List<Integer> ls = new ArrayList<>();
        return func(candidates,target,0,ls,ans);
    }
}
